# Copy to .env and fill in. .env is git-ignored - never commit keys.

# n8n instance to deploy to (local by default)
N8N_URL=http://localhost:5678
# n8n UI: Settings > n8n API > Create an API key
N8N_API_KEY=

# Either give an OpenAI key (deploy creates the "OpenAI - Claims Desk" credential once
# and saves its id below), or create the credential in the UI and paste its id.
OPENAI_API_KEY=
# N8N_OPENAI_CREDENTIAL_ID=
